rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isSupportEmail() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email.lower() in [
        'angelicacb05@gmail.com',
        'santhiagocaro05@gmail.com'
      ];
    }

    function isAdmin() {
      return signedIn() && (request.auth.token.admin == true || isSupportEmail());
    }

    function isSupport() {
      return signedIn() && (request.auth.token.support == true || isSupportEmail());
    }

    function isStaff() {
      return isAdmin() || isSupport();
    }

    function published() {
      return resource.data.get('published', false) == true;
    }

    function reviewBadgeIsValid(badge) {
      let claimed = request.resource.data.get('authorBadges', {}).get(badge, false);
      let profilePath = /databases/$(database)/documents/profiles/$(request.auth.uid);
      return claimed is bool && (!claimed || (
        exists(profilePath) &&
        get(profilePath).data.get('badges', {}).keys().hasAny([badge])
      ));
    }

    match /products/{productId} {
      allow read: if published() || isStaff();
      allow create, update, delete: if isStaff();

      match /reviews/{reviewId} {
        allow read: if isStaff() || (resource.data.get('approved', false) == true &&
          get(/databases/$(database)/documents/products/$(productId)).data.get('published', false) == true) ||
          (signedIn() && request.auth.uid == resource.data.get('authorId', ''));
        allow create: if signedIn()
          && reviewId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'productId', 'productName', 'authorId', 'authorName', 'authorBadges',
            'rating', 'body', 'approved', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.productId == productId
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 70
          && request.resource.data.authorBadges is map
          && request.resource.data.authorBadges.keys().hasOnly(['cliente', 'vip', 'veterano'])
          && reviewBadgeIsValid('cliente')
          && reviewBadgeIsValid('vip')
          && reviewBadgeIsValid('veterano')
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 8
          && request.resource.data.body.size() <= 1000
          && request.resource.data.approved == false
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow update: if isStaff() || (signedIn()
          && request.auth.uid == resource.data.authorId
          && resource.data.get('approved', false) == false
          && request.resource.data.get('approved', false) == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'body', 'updatedAt'])
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 8
          && request.resource.data.body.size() <= 1000);
        allow delete: if isStaff() || (signedIn()
          && request.auth.uid == resource.data.authorId
          && resource.data.get('approved', false) == false);
      }
    }

    match /categories/{categoryId} {
      allow read: if published() || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /carouselSlides/{slideId} {
      allow read: if published() || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /examples/{exampleId} {
      allow read: if published() || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /legalPages/{pageId} {
      allow read: if pageId in ['sale', 'terms'] || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /siteSettings/{settingId} {
      allow read: if settingId == 'visibility' || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /gallery/{imageId} {
      allow read: if published() || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /festivities/{festivityId} {
      allow read: if resource.data.get('published', false) == true || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /announcements/{announcementId} {
      allow read: if published() || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /profiles/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'bannerURL', 'description', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.get('displayName', '') is string
        && request.resource.data.get('email', '') is string
        && (request.resource.data.get('email', '') == '' || request.resource.data.email == request.auth.token.email)
        && request.resource.data.get('description', '') is string
        && request.resource.data.get('description', '').size() <= 300;
      allow update: if isStaff() || (isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'photoURL', 'bannerURL', 'description', 'updatedAt'
        ])
        && request.resource.data.get('displayName', '') is string
        && request.resource.data.get('email', '') is string
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']) || request.resource.data.email == request.auth.token.email)
        && request.resource.data.get('description', '').size() <= 300);
      allow delete: if isStaff();

      match /purchases/{purchaseId} {
        allow read: if isOwner(userId) || isStaff();
        allow create, update, delete: if isStaff();
      }

      match /balanceTransactions/{transactionId} {
        allow read: if isOwner(userId) || isStaff();
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isStaff();
        allow create, update, delete: if isStaff();
      }
    }

    match /reservas/{reservaId} {
      allow read: if signedIn() && (isStaff() || request.auth.uid == resource.data.userId);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pendiente';
      allow update: if isStaff() || (signedIn() && request.auth.uid == resource.data.userId);
      allow delete: if isStaff();
    }

    match /globalNotifications/{notificationId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /supportChats/{chatId} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == resource.data.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isStaff() || (signedIn() && request.auth.uid == resource.data.uid);
      allow delete: if isStaff();

      match /messages/{messageId} {
        allow read: if isStaff() || (signedIn() && request.auth.uid == get(/databases/$(database)/documents/supportChats/$(chatId)).data.uid);
        allow create: if signedIn() && (
          (isStaff() && request.resource.data.sender == 'support' && (
            !request.resource.data.keys().hasAny(['role']) ||
            (request.resource.data.role == 'admin' && isAdmin()) ||
            (request.resource.data.role == 'support' && isSupport())
          )) ||
          (request.auth.uid == get(/databases/$(database)/documents/supportChats/$(chatId)).data.uid &&
            request.resource.data.sender == 'client' &&
            (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'client'))
        );
        allow update, delete: if isStaff();
      }
    }

    match /notifications/{userId}/items/{notificationId} {
      allow read: if signedIn() && (isStaff() || request.auth.uid == userId);
      allow create: if isStaff();
      allow update: if isStaff() || (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']));
      allow delete: if isStaff() || isOwner(userId);
    }

    match /profiles/{userId}/notifications/{notificationId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isStaff() || isOwner(userId);
      allow update: if isStaff() || (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']));
      allow delete: if isStaff() || isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
