rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isSupportEmail() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email.lower() in [
        'angelicacb05@gmail.com',
        'santhiagocaro05@gmail.com'
      ];
    }

    function isAdmin() {
      return signedIn() && (request.auth.token.admin == true || isSupportEmail());
    }

    function isSupport() {
      return signedIn() && (request.auth.token.support == true || isSupportEmail());
    }

    function isStaff() {
      return isAdmin() || isSupport();
    }

    function published() {
      return resource.data.get('published', false) == true;
    }

    match /products/{productId} {
      allow read: if published() || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /categories/{categoryId} {
      allow read: if published() || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /carouselSlides/{slideId} {
      allow read: if published() || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /examples/{exampleId} {
      allow read: if published() || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /legalPages/{pageId} {
      allow read: if pageId in ['sale', 'terms'] || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /siteSettings/{settingId} {
      allow read: if settingId == 'visibility' || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /gallery/{imageId} {
      allow read: if published() || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /festivities/{festivityId} {
      allow read: if resource.data.get('published', false) == true || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /announcements/{announcementId} {
      allow read: if published() || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /profiles/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'photoURL', 'bannerURL', 'description', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.get('displayName', '') is string
        && request.resource.data.get('description', '') is string
        && request.resource.data.get('description', '').size() <= 300;
      allow update: if isStaff() || (isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'bannerURL', 'description', 'updatedAt'
        ])
        && request.resource.data.get('displayName', '') is string
        && request.resource.data.get('description', '').size() <= 300);
      allow delete: if isStaff();

      match /purchases/{purchaseId} {
        allow read: if isOwner(userId) || isStaff();
        allow create, update, delete: if isStaff();
      }

      match /balanceTransactions/{transactionId} {
        allow read: if isOwner(userId) || isStaff();
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isStaff();
        allow create, update, delete: if isStaff();
      }
    }

    match /reservas/{reservaId} {
      allow read: if signedIn() && (isStaff() || request.auth.uid == resource.data.userId);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pendiente';
      allow update: if isStaff() || (signedIn() && request.auth.uid == resource.data.userId);
      allow delete: if isStaff();
    }

    match /globalNotifications/{notificationId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /supportChats/{chatId} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == resource.data.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isStaff() || (signedIn() && request.auth.uid == resource.data.uid);
      allow delete: if isStaff();

      match /messages/{messageId} {
        allow read: if isStaff() || (signedIn() && request.auth.uid == get(/databases/$(database)/documents/supportChats/$(chatId)).data.uid);
        allow create: if signedIn() && (
          (isStaff() && request.resource.data.sender == 'support' && (
            !request.resource.data.keys().hasAny(['role']) ||
            (request.resource.data.role == 'admin' && isAdmin()) ||
            (request.resource.data.role == 'support' && isSupport())
          )) ||
          (request.auth.uid == get(/databases/$(database)/documents/supportChats/$(chatId)).data.uid &&
            request.resource.data.sender == 'client' &&
            (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'client'))
        );
        allow update, delete: if isStaff();
      }
    }

    match /notifications/{userId}/items/{notificationId} {
      allow read: if signedIn() && (isStaff() || request.auth.uid == userId);
      allow create: if isStaff();
      allow update: if isStaff() || (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']));
      allow delete: if isStaff() || isOwner(userId);
    }

    match /profiles/{userId}/notifications/{notificationId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isStaff() || isOwner(userId);
      allow update: if isStaff() || (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']));
      allow delete: if isStaff() || isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
