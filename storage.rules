rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /profiles/{userId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == userId && validImage();
      allow delete: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /catalog/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }

    match /gallery/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
